    <ns1:descripcion>Majestuosa formación rocosa, puerta a la serranía de los Churumbelos.</ns1:descripcion>
    <ns1:imagenURL>https://images.unsplash.com/photo-1518709268805-4e9042af9f23?auto=format&amp;fit=crop&amp;q=80&amp;w=800</ns1:imagenURL>
