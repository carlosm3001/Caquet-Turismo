    <ns1:tipoActividad>Acuática</ns1:tipoActividad>
    <ns1:precio rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</ns1:precio>
    <ns1:descripcion>Tradicional balneario natural de aguas frescas.</ns1:descripcion>
    <ns1:imagenURL>https://images.unsplash.com/photo-1470071459604-3b5ec3a7fe05?auto=format&amp;fit=crop&amp;q=80&amp;w=800</ns1:imagenURL>
