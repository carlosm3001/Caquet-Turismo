  <rdf:Description rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/untitled-ontology-3#Cascada_La_Novia">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/untitled-ontology-3#Actividad"/>
    <ns1:nombreActividad>Cascada La Novia</ns1:nombreActividad>
    <ns1:ubicadaEn rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/untitled-ontology-3#Florencia"/>
    <ns1:nivelDificultad>Media</ns1:nivelDificultad>
    <ns1:tipoActividad>Acuática</ns1:tipoActividad>
    <ns1:precio rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">15000</ns1:precio>
    <ns1:descripcion>Impresionante caída de agua rodeada de selva primaria.</ns1:descripcion>
    <ns1:imagenURL>https://images.unsplash.com/photo-1540206395-6880f94933af?auto=format&amp;fit=crop&amp;q=80&amp;w=800</ns1:imagenURL>
    <ns1:disponibilidad>Disponible</ns1:disponibilidad>
    <ns1:horario>8:00 AM - 4:00 PM</ns1:horario>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/untitled-ontology-3#Rio_Bodoquero">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
