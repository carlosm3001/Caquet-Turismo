    <ns1:nivelDificultad>Alta</ns1:nivelDificultad>
    <ns1:precio rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">80000</ns1:precio>
    <ns1:disponibilidad>Bajo Reserva</ns1:disponibilidad>
