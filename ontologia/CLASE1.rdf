    <ns1:tipoActividad>Senderismo y Conservación</ns1:tipoActividad>
    <ns1:precio rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">50000</ns1:precio>
    <ns1:descripcion>Reserva sagrada con alta biodiversidad andino-amazónica, administrada en conjunto con comunidades indígenas.</ns1:descripcion>
    <ns1:imagenURL>https://images.unsplash.com/photo-1511497584788-876760111969?auto=format&amp;fit=crop&amp;q=80&amp;w=800</ns1:imagenURL>
    <ns1:disponibilidad>Disponible</ns1:disponibilidad>
    <ns1:horario>6:00 AM - 1:00 PM</ns1:horario>
  </rdf:Description>

