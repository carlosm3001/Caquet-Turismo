    <ns1:tipoActividad>Acuática y Senderismo</ns1:tipoActividad>
    <ns1:precio rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">30000</ns1:precio>
    <ns1:descripcion>Espectacular caída de agua de más de 60 metros, rodeada de bosque nativo y biodiversidad andino-amazónica.</ns1:descripcion>
    <ns1:imagenURL>https://images.unsplash.com/photo-1432405972618-fc027058b8d1?auto=format&amp;fit=crop&amp;q=80&amp;w=800</ns1:imagenURL>
    <ns1:disponibilidad>Disponible</ns1:disponibilidad>
    <ns1:horario>8:00 AM - 3:00 PM</ns1:horario>
  </rdf:Description>

