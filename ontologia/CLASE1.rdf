    <ns1:ubicadaEn rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/untitled-ontology-3#Puerto_Rico"/>
    <ns1:nivelDificultad>Media</ns1:nivelDificultad>
    <ns1:tipoActividad>Espeleología</ns1:tipoActividad>
    <ns1:precio rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">35000</ns1:precio>
    <ns1:descripcion>Exploración de cavernas con impresionantes formaciones de estalactitas y estalagmitas que reflejan diversos colores.</ns1:descripcion>
    <ns1:imagenURL>https://images.unsplash.com/photo-1515524738708-327f6b0037a7?auto=format&amp;fit=crop&amp;q=80&amp;w=800</ns1:imagenURL>
    <ns1:disponibilidad>Disponible</ns1:disponibilidad>
    <ns1:horario>8:00 AM - 3:00 PM</ns1:horario>
  </rdf:Description>

  <rdf:Description rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/untitled-ontology-3#Santuario_Indi_Wasi">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/untitled-ontology-3#Actividad"/>
