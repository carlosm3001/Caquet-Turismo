    <ns1:reservaURL>https://wa.me/573123456782</ns1:reservaURL>
    <ns1:descripcion>Caminata por el lecho de un cañón natural con paredes de piedra milenarias. Una experiencia mística.</ns1:descripcion>
    <ns1:horario>Fines de semana - Salidas guiadas a las 9:00 AM</ns1:horario>
