    <ns1:descripcion>Puerta de entrada a la Serranía de los Churumbelos. Experiencia extrema de rafting y exploración.</ns1:descripcion>
    <ns1:horario>Previa reserva - Mínimo 4 personas</ns1:horario>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/untitled-ontology-3#Reserva_El_Danubio">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
