    <ns1:ubicadaEn rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/untitled-ontology-3#Florencia"/>
    <ns1:nivelDificultad>Baja</ns1:nivelDificultad>
    <ns1:tipoActividad>Senderismo</ns1:tipoActividad>
    <ns1:precio rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">25000</ns1:precio>
    <ns1:descripcion>Caminata por el lecho de un cañón natural milenario.</ns1:descripcion>
    <ns1:imagenURL>https://images.unsplash.com/photo-1441974231531-c6227db76b6e?auto=format&amp;fit=crop&amp;q=80&amp;w=800</ns1:imagenURL>
    <ns1:disponibilidad>Disponible</ns1:disponibilidad>
    <ns1:horario>8:00 AM - 4:00 PM</ns1:horario>
  </rdf:Description>

  <rdf:Description rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/untitled-ontology-3#Portal_del_Fragua">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/untitled-ontology-3#Actividad"/>
