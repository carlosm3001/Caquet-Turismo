    <ns1:nivelDificultad>Media</ns1:nivelDificultad>
    <ns1:precio rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">45000</ns1:precio>
    <ns1:disponibilidad>Disponible</ns1:disponibilidad>
    <ns1:reservaURL>https://wa.me/573123456789</ns1:reservaURL>
    <ns1:descripcion>Un santuario de aguas cristalinas color turquesa. Ofrece senderismo selvático y avistamiento de aves exóticas.</ns1:descripcion>
    <ns1:horario>Sábados y Domingos - 8:00 AM a 4:00 PM</ns1:horario>
  </rdf:Description>
