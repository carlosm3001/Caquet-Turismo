    <ns1:tipoActividad>Acuática</ns1:tipoActividad>
    <ns1:precio rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">45000</ns1:precio>
    <ns1:descripcion>Aguas cristalinas color turquesa y senderismo de conservación.</ns1:descripcion>
    <ns1:imagenURL>https://images.unsplash.com/photo-1596394516093-501ba68a0ba6?auto=format&amp;fit=crop&amp;q=80&amp;w=800</ns1:imagenURL>
    <ns1:disponibilidad>Disponible</ns1:disponibilidad>
    <ns1:horario>8:00 AM - 4:00 PM</ns1:horario>
  </rdf:Description>

  <rdf:Description rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/untitled-ontology-3#El_Paraiso_de_Pedro">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/untitled-ontology-3#Actividad"/>
    <ns1:nombreActividad>El Paraíso de Pedro</ns1:nombreActividad>
    <ns1:ubicadaEn rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/untitled-ontology-3#Belen_de_los_Andaquies"/>
    <ns1:nivelDificultad>Baja</ns1:nivelDificultad>
    <ns1:tipoActividad>Ecoturismo</ns1:tipoActividad>
    <ns1:precio rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">20000</ns1:precio>
    <ns1:descripcion>Reserva natural ideal para el avistamiento de aves, descanso y conexión con el río Sarabando.</ns1:descripcion>
    <ns1:imagenURL>https://images.unsplash.com/photo-1448375240586-882707db888b?auto=format&amp;fit=crop&amp;q=80&amp;w=800</ns1:imagenURL>
    <ns1:disponibilidad>Disponible</ns1:disponibilidad>
    <ns1:horario>7:00 AM - 5:00 PM</ns1:horario>
  </rdf:Description>

  <rdf:Description rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/untitled-ontology-3#Cascada_Anayacito">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/untitled-ontology-3#Actividad"/>
    <ns1:nombreActividad>Cascada Anayacito</ns1:nombreActividad>
    <ns1:ubicadaEn rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/untitled-ontology-3#El_Doncello"/>
    <ns1:nivelDificultad>Media</ns1:nivelDificultad>
    <ns1:tipoActividad>Acuática y Senderismo</ns1:tipoActividad>
    <ns1:precio rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">30000</ns1:precio>
    <ns1:descripcion>Espectacular caída de agua de más de 60 metros, rodeada de bosque nativo y biodiversidad andino-amazónica.</ns1:descripcion>
    <ns1:imagenURL>https://images.unsplash.com/photo-1432405972618-fc027058b8d1?auto=format&amp;fit=crop&amp;q=80&amp;w=800</ns1:imagenURL>
    <ns1:disponibilidad>Disponible</ns1:disponibilidad>
    <ns1:horario>8:00 AM - 3:00 PM</ns1:horario>
  </rdf:Description>

  <rdf:Description rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/untitled-ontology-3#Reserva_Las_Pailas">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/untitled-ontology-3#Actividad"/>
    <ns1:nombreActividad>Reserva Natural Las Pailas</ns1:nombreActividad>
    <ns1:ubicadaEn rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/untitled-ontology-3#Florencia"/>
    <ns1:nivelDificultad>Baja</ns1:nivelDificultad>
    <ns1:tipoActividad>Acuática y Ecoturismo</ns1:tipoActividad>
    <ns1:precio rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10000</ns1:precio>
    <ns1:descripcion>Formaciones rocosas naturales que crean piscinas y toboganes de agua cristalina en medio del bosque.</ns1:descripcion>
    <ns1:imagenURL>https://images.unsplash.com/photo-1544551763-46a013bb70d5?auto=format&amp;fit=crop&amp;q=80&amp;w=800</ns1:imagenURL>
    <ns1:disponibilidad>Disponible</ns1:disponibilidad>
    <ns1:horario>8:00 AM - 5:00 PM</ns1:horario>
  </rdf:Description>

  <rdf:Description rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/untitled-ontology-3#Rapidos_del_Caguan">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/untitled-ontology-3#Actividad"/>
    <ns1:nombreActividad>Rafting en los Rápidos del Caguán</ns1:nombreActividad>
    <ns1:ubicadaEn rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/untitled-ontology-3#San_Vicente_del_Caguan"/>
    <ns1:nivelDificultad>Alta</ns1:nivelDificultad>
    <ns1:tipoActividad>Aventura y Deportes Acuáticos</ns1:tipoActividad>
    <ns1:precio rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">120000</ns1:precio>
    <ns1:descripcion>Descenso en balsa por los emocionantes rápidos del imponente Río Caguán, ideal para el turismo de aventura.</ns1:descripcion>
    <ns1:imagenURL>https://images.unsplash.com/photo-1530866495561-507c9faab2ed?auto=format&amp;fit=crop&amp;q=80&amp;w=800</ns1:imagenURL>
    <ns1:disponibilidad>Disponible</ns1:disponibilidad>
    <ns1:horario>7:00 AM - 2:00 PM</ns1:horario>
  </rdf:Description>

  <rdf:Description rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/untitled-ontology-3#Cueva_de_los_Colores">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/untitled-ontology-3#Actividad"/>
