    <ns1:ubicadaEn rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/untitled-ontology-3#Morelia"/>
    <ns1:nivelDificultad>Baja</ns1:nivelDificultad>
    <ns1:tipoActividad>Acuática</ns1:tipoActividad>
    <ns1:precio rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</ns1:precio>
    <ns1:descripcion>Tradicional balneario natural de aguas frescas.</ns1:descripcion>
    <ns1:imagenURL>https://images.unsplash.com/photo-1470071459604-3b5ec3a7fe05?auto=format&amp;fit=crop&amp;q=80&amp;w=800</ns1:imagenURL>
    <ns1:disponibilidad>Disponible</ns1:disponibilidad>
    <ns1:horario>8:00 AM - 4:00 PM</ns1:horario>
  </rdf:Description>

  <rdf:Description rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/untitled-ontology-3#Las_Dalias">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.semanticweb.org/user/ontologies/2026/2/untitled-ontology-3#Actividad"/>
