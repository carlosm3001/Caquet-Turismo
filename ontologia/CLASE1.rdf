    <ns1:tipoActividad>Ecoturismo</ns1:tipoActividad>
    <ns1:precio rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">20000</ns1:precio>
    <ns1:descripcion>Reserva natural ideal para el avistamiento de aves, descanso y conexión con el río Sarabando.</ns1:descripcion>
    <ns1:imagenURL>https://images.unsplash.com/photo-1448375240586-882707db888b?auto=format&amp;fit=crop&amp;q=80&amp;w=800</ns1:imagenURL>
    <ns1:disponibilidad>Disponible</ns1:disponibilidad>
    <ns1:horario>7:00 AM - 5:00 PM</ns1:horario>
  </rdf:Description>

  <rdf:Description rdf:about="http://www.semanticweb.org/user/ontologies/2026/2/untitled-ontology-3#Cascada_Anayacito">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
