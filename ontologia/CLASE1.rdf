    <ns1:disponibilidad>Acceso Libre</ns1:disponibilidad>
    <ns1:reservaURL>N/A</ns1:reservaURL>
    <ns1:descripcion>El balneario más tradicional del Caquetá. Aguas refrescantes y zonas de camping.</ns1:descripcion>
